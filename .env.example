# Parrot Ops Configuration
# Copy this file to .env and fill in your settings
#   cp .env.example .env

# ── LLM Backend ──────────────────────────────────────────────
# Choose: anthropic | openai
PARROT_LLM_BACKEND=anthropic

# ── Model ────────────────────────────────────────────────────
# Anthropic: claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5
# OpenAI:   gpt-4o | gpt-4-turbo | gpt-4
# 兼容接口: 填模型名即可，同时设置对应的 BASE_URL
PARROT_MODEL=claude-sonnet-4-6

# ── Anthropic (Claude) API ───────────────────────────────────
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# 代理或企业部署时修改 (默认: https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# ── OpenAI API ───────────────────────────────────────────────
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Azure OpenAI / 代理 / Ollama / 其他兼容接口时修改 (默认: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/gpt-4o
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── Output ───────────────────────────────────────────────────
# Skill YAML 默认输出目录 (默认: ./skills)
# PARROT_OUTPUT_DIR=./skills
